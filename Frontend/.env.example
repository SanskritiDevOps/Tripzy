# API base URL used by the browser. Defaults to /api, which the Vite dev server
# proxies to the backend (see vite.config.js). Set a full URL in production,
# e.g. https://api.tripzy.app/api
VITE_API_URL=/api

# Where the dev proxy forwards /api and /socket.io (development only)
VITE_DEV_API_TARGET=http://localhost:5000

# Socket.IO server for live trip updates. Defaults to the API's origin when VITE_API_URL
# is a full URL, otherwise this site (the dev server proxies /socket.io).
# VITE_SOCKET_URL=https://api.tripzy.app
