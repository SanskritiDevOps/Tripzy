# API base URL used by the browser. Defaults to /api, which the Vite dev server
# proxies to the backend (see vite.config.js). Set a full URL in production,
# e.g. https://api.tripzy.app/api
VITE_API_URL=/api

# Where the dev proxy forwards /api requests (development only)
VITE_DEV_API_TARGET=http://localhost:5000
