// Tripzy database schema (README §7).
// Models are added feature by feature; this revision covers auth and trips.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TripRole {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  /// Always stored lowercased by the auth service.
  email        String   @unique
  /// bcrypt hash. Nullable to allow Google login later.
  passwordHash String?  @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  ownedTrips    Trip[]         @relation("TripOwner")
  memberships   TripMember[]

  @@map("users")
}

/// Opaque refresh tokens, stored as SHA-256 hashes and rotated on every use.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  /// Every token issued from one login shares a family; reuse of a rotated
  /// token revokes the whole family.
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  /// ROTATED (exchanged for a new token), LOGOUT, or REUSE (family killed after a replay).
  revokedReason String? @map("revoked_reason")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Trip {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  destination    String
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  currency       String    @default("INR")
  /// Group budget in minor units (paise).
  budgetMinor    BigInt    @default(0) @map("budget_minor")
  groupType      String    @default("friends") @map("group_type")
  ownerId        String    @map("owner_id") @db.Uuid
  votingDeadline DateTime? @map("voting_deadline")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  owner   User         @relation("TripOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members TripMember[]

  @@index([ownerId])
  @@map("trips")
}

model TripMember {
  tripId   String   @map("trip_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     TripRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}
