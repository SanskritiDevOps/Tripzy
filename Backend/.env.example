NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://tripzy:tripzy@localhost:5432/tripzy?schema=public
# Used by `npm test`; tables in this database are wiped between tests
TEST_DATABASE_URL=postgresql://tripzy:tripzy@localhost:5432/tripzy_test?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Optional: enables "Continue with Google". Create an OAuth 2.0 *Web application* client in
# Google Cloud Console → APIs & Services → Credentials, and add http://localhost:5173 (and
# http://localhost) to its Authorized JavaScript origins. Leave empty to hide the button.
GOOGLE_CLIENT_ID=

# Invite emails (Nodemailer). Without SMTP_URL, emails are written to the API log
# and the leader can copy the join link from the invite dialog instead.
SMTP_URL=
# On free hosting (Render, Railway) SMTP ports are blocked: use Brevo's HTTPS API instead
# (free, 300 emails/day). Create a key at https://app.brevo.com/settings/keys/api and verify
# the MAIL_FROM address under Senders. When set, it is used instead of SMTP_URL.
BREVO_API_KEY=
MAIL_FROM=Tripzy <no-reply@tripzy.app>
# Frontend URL used in invite links; defaults to the first CLIENT_URL
APP_URL=
INVITE_TTL_DAYS=7

# Place search and trip map centres use OpenStreetMap Nominatim (free, no key, max 1 request/s,
# results cached). Set to empty to disable, or point to your own Nominatim for heavy use.
GEOCODER_URL=https://nominatim.openstreetmap.org
# Contact email sent with map searches, as Nominatim's usage policy asks (optional)
GEOCODER_EMAIL=

# Optional: AI itinerary planning with Google Gemini. Create a free key at
# https://aistudio.google.com/apikey and paste it here (never commit it). Free-tier
# prompts may be used by Google to improve its products. Without a key, "Plan with AI"
# uses the built-in route-based planner instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Per-request timeout for the AI call (ms)
AI_TIMEOUT_MS=30000

# lax for local dev; "none" when frontend and API are on different sites in production (requires HTTPS)
COOKIE_SAMESITE=lax
# Number of proxies in front of the API (e.g. 1 on Render/Railway) so rate limiting sees real client IPs
TRUST_PROXY=0
