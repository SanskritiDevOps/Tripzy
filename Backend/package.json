  "description": "Tripzy REST API (Express + Prisma + Socket.IO)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/server.js",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
